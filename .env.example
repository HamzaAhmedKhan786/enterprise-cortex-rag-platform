# Copy to .env. Never commit real credentials.
CORTEX_DB=data/private/cortex.sqlite3
CORTEX_ADMIN_USER_ID=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Cloud explanations accept aggregate numbers only, not user questions/documents.
GROQ_API_KEY=
CLOUD_MODEL=llama-3.3-70b-versatile
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
DEEPEVAL_TELEMETRY_OPT_OUT=1
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOGISTICS_BASE_URL=
LOGISTICS_API_KEY=
MARKET_BASE_URL=
MARKET_API_KEY=
# Optional legacy PostgreSQL and Pinecone scripts
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_cortex_rag
DB_USER=postgres
DB_PASSWORD=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-rag
# Docker observability profile
GRAFANA_ADMIN_PASSWORD=
