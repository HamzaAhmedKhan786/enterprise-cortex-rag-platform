# Copy to .env. Never commit real credentials.
CORTEX_DB=data/private/cortex.sqlite3
CORTEX_ADMIN_USER_ID=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Cloud explanations accept aggregate numbers only, not user questions/documents.
GROQ_API_KEY=
CLOUD_MODEL=llama-3.3-70b-versatile
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
DEEPEVAL_TELEMETRY_OPT_OUT=1
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOGISTICS_BASE_URL=
LOGISTICS_API_KEY=
MARKET_BASE_URL=
MARKET_API_KEY=
# Optional legacy PostgreSQL and Pinecone scripts
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterprise_cortex_rag
DB_USER=postgres
DB_PASSWORD=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-rag
# Docker observability profile
GRAFANA_ADMIN_PASSWORD=

# Stripe: use test mode until intentionally enabling live billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_ALLOW_LIVE=false
APP_BASE_URL=http://localhost:8501

# Local antivirus; never expose unauthenticated ClamD outside a trusted network.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3311

# Shared Snowflake credentials are administrator-only. No arbitrary SQL is exposed.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_ALLOWED_TABLES=

# Authenticated companion billing UI, webhooks and return URLs.
BILLING_BASE_URL=http://localhost:8503
# Hosted Checkout/Portal do not need a publishable key; reserved for future Elements UI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
